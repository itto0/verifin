# --- Frontend Build-Time Config (Vite) ---
VITE_AI_BASE_URL="/api/ai"
VITE_AI_API_KEY=""
VITE_AI_MODEL="antigravity/gemini-3-flash-preview"

# --- Docker Compose & Nginx Proxy ---
COMPOSE_PROJECT_NAME=verifin
APP_PORT=80
# Origin only (trailing slashes are stripped automatically on container start)
PROCESSING_UPSTREAM_URL=http://processing:8000
# Normalized with a trailing slash to strip /api/ai/ prefix when forwarding
AI_UPSTREAM_URL=https://or.flux.id/v1/
# "auto" reads /etc/resolv.conf (127.0.0.11 inside Docker Compose), or set an explicit DNS IP
NGINX_RESOLVER=auto

# --- Python Processing Service ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
BLUR_THRESHOLD=100.0
MIN_IMAGE_WIDTH=600
HESITATION_SILENCE_THRESHOLD=1.5
CORS_ORIGINS='["*"]'
